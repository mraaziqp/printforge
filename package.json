{
  "name": "printforge",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-printforge.ps1",
    "dev": "vite --port=5173",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "lint:bridge": "server\\.venv\\Scripts\\python.exe -m ruff check server",
    "bridge:setup": "powershell -ExecutionPolicy Bypass -File server/setup.ps1",
    "bridge": "server\\.venv\\Scripts\\python.exe server/bridge.py"
  },
  "dependencies": {
    "lucide-react": "^1.45.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "three": "^0.186.0",
    "three-bvh-csg": "^0.0.18"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
